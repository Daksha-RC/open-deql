{
  "name": "open-deql",
  "build": {
    "dockerfile": "Dockerfile",
  },
  "workspaceFolder": "/home/coder/open-deql",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/coder/open-deql,type=bind",
  "forwardPorts": [5080, 8081],
  "mounts": [],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
  },
  "containerEnv": {
    "OMLX_LLM_API_KEY": "${localEnv:OMLX_LLM_API_KEY}",
  },
  "remoteUser": "coder",
  "containerUser": "coder",
}
